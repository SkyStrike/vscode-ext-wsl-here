{
  "name": "wsl-here",
  "displayName": "WSL Here",
  "description": "Opens WSL in selected folder via the menu",
  "publisher": "SkyStrike",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyStrike/vscode-ext-wsl-here.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wslFolderMenu.openInWsl",
        "title": "Open in WSL Terminal",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "wslFolderMenu.openInWsl",
          "when": "explorerResourceIsFolder",
          "group": "navigation@100"
        },
        {
          "command": "wslFolderMenu.openInWsl",
          "when": "!explorerResourceIsFolder && !inputFocus",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "WSL Here",
      "properties": {
        "wslHere.shellPath": {
          "type": "string",
          "default": "C:\\Windows\\System32\\wsl.exe",
          "description": "Path to the WSL executable."
        },
        "wslHere.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-d",
            "Ubuntu"
          ],
          "description": "Command line arguments passed to WSL (e.g. [\"-d\", \"Ubuntu\"])."
        },
        "wslHere.customCwd": {
          "type": "string",
          "default": "",
          "description": "Optional custom working directory override. Leave empty to use selected item directory path."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
